{
  "name": "gss-finance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --packages=external --format=esm --outfile=dist/server.js",
    "start": "node dist/server.js",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx script/migrate.ts",
    "db:seed-demo": "tsx script/seed-demo.ts",
    "release": "node script/release.mjs",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs --update-env",
    "pm2:stop": "pm2 stop gss-finance",
    "pm2:logs": "pm2 logs gss-finance",
    "pm2:status": "pm2 status gss-finance"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.4",
    "express": "^4.22.3",
    "express-session": "^1.18.1",
    "lucide-react": "^0.468.0",
    "multer": "^2.5.0",
    "pg": "^8.16.3",
    "pm2": "^7.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.1",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.5",
    "typescript": "^5.6.3",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
