# Copy this file to .env on the deployment server and replace every placeholder.
# Use a NEW, empty production database, not the development/demo database.
DATABASE_URL=postgres://gss_finance_app:REPLACE_DATABASE_PASSWORD@127.0.0.1:5432/gss_finance_production
SESSION_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS

# The fixed super administrator is admin / gamestrixstudios@gmail.com.
# Supply a strong initial password; it is used only for first-time provisioning.
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_STRONG_PASSWORD

NODE_ENV=production
HOST=127.0.0.1
PORT=5000
# Required for HTTPS through Cloudflare Tunnel or a trusted local reverse proxy.
TRUST_PROXY=1
# Use an absolute, persistent directory outside versioned release folders.
UPLOAD_DIR=/var/lib/gss-finance/uploads
